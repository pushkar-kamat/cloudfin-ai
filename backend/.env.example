GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=8
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=15

# Provider routing. For the current project, Groq is primary and Gemini is fallback.
LLM_PRIMARY=groq
LLM_FALLBACK=gemini
LLM_FAILURE_THRESHOLD=1
LLM_CIRCUIT_BREAKER_SECONDS=180

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_EMAILS=
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Viva-friendly retrieval settings
TOP_K=5
MIN_RELEVANCE=0.055
WORD_TFIDF_WEIGHT=0.75
CHAR_TFIDF_WEIGHT=0.25
CHUNK_SIZE=1400
CHUNK_OVERLAP=180
MAX_HISTORY_MESSAGES=4
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=100
MAX_UPLOAD_MB=8
